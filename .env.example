# Скопируйте в .env и заполните. Все переменные валидируются zod при старте
# (apps/api/src/config.ts, apps/worker/src/config.ts, apps/bot/src/config.ts):
# отсутствие обязательной переменной роняет процесс.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# --- Инфраструктура (docker compose up -d) ---
DATABASE_URL=postgresql://kadr:kadr@localhost:5432/kadr?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kadr
S3_PUBLIC_URL=http://localhost:9000/kadr

# --- Секреты приложения ---
# минимум 32 символа: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me

# --- Telegram ---
BOT_TOKEN=123456789:replace-with-your-bot-token

# --- Провайдеры ---
FAL_KEY=replace-with-fal-key
GEMINI_KEY=replace-with-gemini-key
# GEMINI_MODEL=gemini-2.5-flash   # модель enhancer'а, менять не обязательно

# --- ЮKassa ---
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET=replace-with-yookassa-secret
