// Prisma-схема Kadr. Модели добавляются по сессиям ТЗ.
// Миграции — только через `pnpm migrate` (prisma migrate dev). Руками SQL не править
// (исключение по ТЗ §4: CHECK-констрейнты credit_accounts дописаны в SQL миграции).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users (сессия 3), CreditAccount + Ledger (сессия 2)
// ---------------------------------------------------------------------------

model User {
  id                   String    @id @default(cuid())
  telegramId           BigInt    @unique @map("telegram_id")
  firstName            String?   @map("first_name")
  lastName             String?   @map("last_name")
  username             String?
  avatarUrl            String?   @map("avatar_url")
  languageCode         String?   @map("language_code")
  email                String?
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  /// Короткий код для реферальных ссылок (8 символов base58)
  referralCode         String    @unique @map("referral_code")
  /// id пригласившего пользователя (из start_param ref_<code> при регистрации)
  referredBy           String?   @map("referred_by")
  signupBonusGrantedAt DateTime? @map("signup_bonus_granted_at")
  lastLoginAt          DateTime? @map("last_login_at")
  bannedAt             DateTime? @map("banned_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  account CreditAccount?
  streak  Streak?

  @@map("users")
}

/// Баланс кредитов. Менять ТОЛЬКО через LedgerService (@kadr/ledger).
/// CHECK (balance >= 0), CHECK (reserved >= 0) — в SQL миграции.
model CreditAccount {
  userId    String   @id @map("user_id")
  balance   BigInt   @default(0)
  reserved  BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credit_accounts")
}

enum LedgerType {
  PURCHASE
  SPEND
  REFUND
  BONUS
  DAILY
  REFERRAL
  MANUAL
}

/// Журнал движений. delta со знаком; резерв записи не создаёт, release пишет delta=0.
/// Инвариант: SUM(delta) по пользователю == balance + reserved.
model LedgerEntry {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  delta          BigInt
  type           LedgerType
  refType        String?    @map("ref_type")
  refId          String?    @map("ref_id")
  balanceAfter   BigInt     @map("balance_after")
  idempotencyKey String?    @unique @map("idempotency_key")
  comment        String?
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([refType, refId])
  @@map("ledger_entries")
}

/// Расхождения, найденные cron-сверкой (worker, раз в час).
model LedgerMismatch {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  expected   BigInt
  balance    BigInt
  reserved   BigInt
  detectedAt DateTime @default(now()) @map("detected_at")

  @@index([userId, detectedAt(sort: Desc)])
  @@map("ledger_mismatches")
}

// ---------------------------------------------------------------------------
// Catalog (сессия 4): операции генерации и пакеты кредитов.
// Данные заведены сид-INSERT'ами в миграции catalog; правки — сидом/SQL до появления админки.
// ---------------------------------------------------------------------------

enum OperationKind {
  IMAGE
  VIDEO
  AUDIO
  EDIT
  UPSCALE
}

enum OperationTier {
  DRAFT
  STANDARD
  PREMIUM
}

/// Операция генерации: цена в кредитах, оценка себестоимости, цепочка провайдеров
/// (ProviderRouter, сессия 5) и JSON-схема параметров (валидация в generations, сессия 6).
/// cogsUsdEst и providerChain наружу не отдаются.
model Operation {
  key          String        @id
  kind         OperationKind
  tier         OperationTier
  title        String
  priceCredits Int           @map("price_credits")
  cogsUsdEst   Decimal       @map("cogs_usd_est") @db.Decimal(10, 4)
  providerChain Json         @map("provider_chain")
  paramsSchema Json          @map("params_schema")
  etaSec       Int           @map("eta_sec")
  isActive     Boolean       @default(true) @map("is_active")
  sort         Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([isActive, sort])
  @@map("operations")
}

/// Пакет кредитов. priceRub — в РУБЛЯХ целиком (в копейки переводит payments, сессия 7).
model Package {
  id        String   @id @default(cuid())
  priceRub  Int      @map("price_rub")
  credits   BigInt
  bonusPct  Int      @default(0) @map("bonus_pct")
  badge     String?
  isActive  Boolean  @default(true) @map("is_active")
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sort])
  @@map("packages")
}

// ---------------------------------------------------------------------------
// Daily claim + streak (сессия 3). Дата — календарный день UTC в формате YYYY-MM-DD.
// ---------------------------------------------------------------------------

model DailyClaim {
  userId    String   @map("user_id")
  date      String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, date])
  @@map("daily_claims")
}

model Streak {
  userId        String   @id @map("user_id")
  current       Int      @default(0)
  best          Int      @default(0)
  lastClaimDate String?  @map("last_claim_date") @db.VarChar(10)
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("streaks")
}
