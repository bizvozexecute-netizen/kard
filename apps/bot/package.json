{
  "name": "@kadr/bot",
  "version": "0.0.1",
  "private": true,
  "description": "Kadr Telegram-бот (grammY)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
